# ------------------------------------------------------------------
# PayMesh environment configuration
# Copy to .env and fill in. All values are optional for local dev.
# ------------------------------------------------------------------

# App
APP_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (local docker-compose defaults)
DATABASE_URL=postgresql://paymesh:paymesh@localhost:5432/paymesh
# CI / ephemeral DB URL is provided by Testcontainers.

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Local chain (Anvil). No keys required.
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337

# Real testnet RPCs (optional; if set, the registry is used instead of Anvil)
ALCHEMY_SEPOLIA_RPC=
ALCHEMY_BASE_SEPOLIA_RPC=
ALCHEMY_ARBITRUM_SEPOLIA_RPC=
INFURA_SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology/
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Mainnet (enable only after verification and a small canary)
ETHEREUM_MAINNET_RPC=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
BASE_MAINNET_RPC=https://base-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
POLYGON_MAINNET_RPC=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID


# On-chain routing (set after `pnpm deploy:anvil` — use the printed addresses)
PAYMESH_SOURCE_CHAIN_ID=31337
PAYMESH_DEST_CHAIN_ID=80002
# Comma-separated destinations available to developers. Empty = PAYMESH_DEST_CHAIN_ID only.
PAYMESH_DEST_CHAIN_IDS=1,8453,137,43114,42161,10,59144,143,56,324
PAYMESH_DEX_ADDRESS=
PAYMESH_BRIDGE_ADDRESS=
PAYMESH_DEST_BRIDGE_ADDRESS=
PAYMESH_SEPOLIA_DEX_ADDRESS=
PAYMESH_SEPOLIA_BRIDGE_ADDRESS=
PAYMESH_BASE_SEPOLIA_DEX_ADDRESS=
PAYMESH_BASE_SEPOLIA_BRIDGE_ADDRESS=
PAYMESH_SEPOLIA_DEX_ROUTER_ADDRESS=
PAYMESH_BASE_SEPOLIA_DEX_ROUTER_ADDRESS=
PAYMESH_SEPOLIA_UNISWAP_V3_ROUTER_ADDRESS=0x3bFA4769FB09eefC5a80d6E87c3B9C650f7Ae48E
PAYMESH_BASE_SEPOLIA_UNISWAP_V3_ROUTER_ADDRESS=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4
PAYMESH_SEPOLIA_UNISWAP_V3_QUOTER_ADDRESS=0xEd1f6473345F45b75F8179591dd5bA1888cf2FB3
PAYMESH_BASE_SEPOLIA_UNISWAP_V3_QUOTER_ADDRESS=0xC5290058841028F1614F3A6F0F5816cAd0df5E27
PAYMESH_SEPOLIA_USDT_ADDRESS=
PAYMESH_BASE_SEPOLIA_USDT_ADDRESS=
PAYMESH_SEPOLIA_WETH_ADDRESS=
PAYMESH_BASE_SEPOLIA_WETH_ADDRESS=
POLYGON_AMOY_USDC_ADDRESS=
ETHEREUM_MAINNET_PRIVATE_KEY=
BASE_MAINNET_PRIVATE_KEY=
POLYGON_MAINNET_PRIVATE_KEY=
PAYMESH_ETHEREUM_MAINNET_UNISWAP_V3_ROUTER_ADDRESS=0xE592427A0AEce92De3Edee1F18E0157C05861564
PAYMESH_ETHEREUM_MAINNET_UNISWAP_V3_QUOTER_ADDRESS=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
PAYMESH_BASE_MAINNET_UNISWAP_V3_ROUTER_ADDRESS=0x2626664c2603336E57B271c5C0b26F421741e481
PAYMESH_BASE_MAINNET_UNISWAP_V3_QUOTER_ADDRESS=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a
PAYMESH_POLYGON_MAINNET_UNISWAP_V3_ROUTER_ADDRESS=0xE592427A0AEce92De3Edee1F18E0157C05861564
PAYMESH_POLYGON_MAINNET_UNISWAP_V3_QUOTER_ADDRESS=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
PAYMESH_WETH_ADDRESS=
PAYMESH_USDC_ADDRESS=
CCTP_ENABLED=false
CCTP_SEPOLIA_TOKEN_MESSENGER_ADDRESS=
CCTP_BASE_SEPOLIA_TOKEN_MESSENGER_ADDRESS=
CCTP_POLYGON_AMOY_MESSAGE_TRANSMITTER_ADDRESS=
CCTP_ETHEREUM_MAINNET_TOKEN_MESSENGER_ADDRESS=0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d
CCTP_BASE_MAINNET_TOKEN_MESSENGER_ADDRESS=0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d
CCTP_POLYGON_MAINNET_TOKEN_MESSENGER_ADDRESS=0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d
CCTP_ETHEREUM_MAINNET_MESSAGE_TRANSMITTER_ADDRESS=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64
CCTP_BASE_MAINNET_MESSAGE_TRANSMITTER_ADDRESS=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64
CCTP_POLYGON_MAINNET_MESSAGE_TRANSMITTER_ADDRESS=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64
CCTP_IRIS_API_URL=https://iris-api-sandbox.circle.com
CCTP_MAX_FEE=10000
CCTP_MIN_FINALITY_THRESHOLD=1000
RELAYER_PRIVATE_KEY=
ROUTE_PROVIDER_URLS=
PAYMESH_ALLOW_MOCK_ROUTES=false
LIFI_ENABLED=true
LIFI_API_URL=https://li.quest/v1
LIFI_API_KEY=
LIFI_INTEGRATOR=depowar

# Simulates the best candidate's first transaction (eth_call) before a quote
# is returned (PRD §simulate before you commit).
SIMULATE_QUOTES=true

# Mainnet preview / canary tool (scripts/mainnet-preview.mjs) is safe by
# default: it quotes and eth_call-simulates only. Broadcasting real funds
# requires APP_ENV=production AND the --confirm-live flag (10s abort window).

# Next-gen routing federated providers (Next-Gen Routing PRD).
# Tier-2 DEX aggregator. Requires an API key from 1inch Developer Portal.
ONEINCH_ENABLED=false
ONEINCH_API_URL=https://api.1inch.dev
ONEINCH_API_KEY=
ONEINCH_ROUTER_ADDRESS=0x111111125421cA6dc452d289314280a0f8842A65
# Tier-1 intent bridge. Mainnet-only; has no effect on testnets.
ACROSS_ENABLED=false
ACROSS_API_URL=https://api.across.to
ACROSS_INTEGRATOR_ID=
ACROSS_API_KEY=
# Backup rail. Router entries are
# "<chainId>:<router>:<sourceChainSelector>:<destChainSelector>:<destChainId>".
# CCIP_TOKEN entries are "<chainId>:<tokenAddress>".
CCIP_ENABLED=false
CCIP_ROUTERS=
CCIP_TOKEN=

# Never commit real private keys. Prefer separate test wallets per network.
SEPOLIA_PRIVATE_KEY=
BASE_SEPOLIA_PRIVATE_KEY=
POLYGON_AMOY_PRIVATE_KEY=

# API security
API_KEY_SECRET=dev-secret-change-me
AUTH_JWT_SECRET=dev-auth-secret-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback
DASHBOARD_URL=http://localhost:5174
WEBHOOK_HMAC_SECRET=dev-webhook-secret-change-me
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300

# Screening deny-list (optional; comma-separated addresses)
SCREENING_DENY_LIST=

# Queue concurrency
TX_MONITOR_POLL_MS=1500
TX_MONITOR_TIMEOUT_MS=120000
TX_VALIDATION_ENABLED=true
WEBHOOK_MAX_ATTEMPTS=5
# Fallback-route orchestration guards (PRD §Fallback Safety)
FALLBACK_MAX_DEPTH=3
FALLBACK_QUEUE_ATTEMPTS=5
# Periodic re-enqueue sweep for SETTLEMENT_PENDING rows (ms)
RECOVERY_SWEEP_INTERVAL_MS=300000

# Anvil deployment (testkit)
ANVIL_ACCOUNT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
