# ------------------------------------------------------------------
# PayMesh environment configuration
# Copy to .env and fill in. All values are optional for local dev.
# ------------------------------------------------------------------

# App
APP_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (local docker-compose defaults)
DATABASE_URL=postgresql://paymesh:paymesh@localhost:5432/paymesh
# CI / ephemeral DB URL is provided by Testcontainers.

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Local chain (Anvil). No keys required.
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337

# Real testnet RPCs (optional; if set, the registry is used instead of Anvil)
ALCHEMY_SEPOLIA_RPC=
ALCHEMY_BASE_SEPOLIA_RPC=
ALCHEMY_ARBITRUM_SEPOLIA_RPC=
INFURA_SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology/
BASE_SEPOLIA_RPC=https://sepolia.base.org


# On-chain routing (set after `pnpm deploy:anvil` — use the printed addresses)
PAYMESH_SOURCE_CHAIN_ID=31337
PAYMESH_DEST_CHAIN_ID=80002
PAYMESH_DEX_ADDRESS=
PAYMESH_BRIDGE_ADDRESS=
PAYMESH_DEST_BRIDGE_ADDRESS=
PAYMESH_SEPOLIA_DEX_ADDRESS=
PAYMESH_SEPOLIA_BRIDGE_ADDRESS=
PAYMESH_BASE_SEPOLIA_DEX_ADDRESS=
PAYMESH_BASE_SEPOLIA_BRIDGE_ADDRESS=
POLYGON_AMOY_USDC_ADDRESS=
PAYMESH_WETH_ADDRESS=
PAYMESH_USDC_ADDRESS=
RELAYER_PRIVATE_KEY=

# Never commit real private keys. Prefer separate test wallets per network.
SEPOLIA_PRIVATE_KEY=
BASE_SEPOLIA_PRIVATE_KEY=
POLYGON_AMOY_PRIVATE_KEY=

# API security
API_KEY_SECRET=dev-secret-change-me
WEBHOOK_HMAC_SECRET=dev-webhook-secret-change-me
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300

# Screening deny-list (optional; comma-separated addresses)
SCREENING_DENY_LIST=

# Queue concurrency
TX_MONITOR_POLL_MS=1500
TX_MONITOR_TIMEOUT_MS=120000
WEBHOOK_MAX_ATTEMPTS=5

# Anvil deployment (testkit)
ANVIL_ACCOUNT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
