{
  "name": "@paymesh/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run test/*.spec.ts",
    "test:e2e": "tsc -p tsconfig.json && vitest run test/e2e",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.3.0",
    "@paymesh/config": "workspace:*",
    "@paymesh/db": "workspace:*",
    "@paymesh/routing-engine": "workspace:*",
    "bullmq": "^5.34.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "viem": "^2.21.0",
    "zod": "^3.24.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "testcontainers": "^10.15.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^3.2.4",
    "@paymesh/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^10.15.0",
    "@testcontainers/redis": "^10.15.0"
  }
}
