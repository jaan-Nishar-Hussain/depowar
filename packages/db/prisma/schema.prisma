generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  memberships  Membership[]
}

/// Workspace: a team + billing boundary. A user belongs via Membership.
model Organization {
  id           String        @id @default(cuid())
  name         String
  ownerId      String?
  owner        User?         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  memberships  Membership[]
  projects     Project[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("DEVELOPER")
  status         String       @default("ACTIVE")
  invitedBy      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
}

/// Project: the scoping unit. API keys, receivers, webhooks and deposits all
/// belong to a Project. A project is TEST or LIVE — create a TEST project and
/// a LIVE sibling for the same integration (PRD §Onboarding: keys require an
/// explicitly created project; one active key per project).
model Project {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  environment    String       @default("TEST") // TEST | LIVE
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]
  recipients     Recipient[]
  depositIntents DepositIntent[]
  webhooks       WebhookSubscription[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, environment])
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyPrefix  String
  keyHash    String    @unique
  name       String?
  environment String   @default("TEST")
  scopes     String[]  @default(["deposits", "quote", "webhooks"])
  enabled    Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt DateTime?

  @@index([projectId, enabled])
}

/// Recipient: where and how funds settle (PRD §8).
model Recipient {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  walletAddress     String
  settlementType    String             @default("EOA") // EOA | CONTRACT
  preferredChainId  Int?
  preferredToken    String?
  kycStatus         String             @default("none") // none | screened | denied
  amlStatus         String             @default("PENDING_REVIEW")
  settlementConfigs SettlementConfig[]
  depositIntents    DepositIntent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model SettlementConfig {
  id             String    @id @default(cuid())
  recipientId    String
  recipient      Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  chainId        Int
  token          String // token address or 'native'
  settlementType String    @default("EOA") // EOA | CONTRACT
  contractAddress String?
  minAmount      Decimal? @db.Decimal(78, 0)
  maxAmount      Decimal? @db.Decimal(78, 0)
  enabled        Boolean   @default(true)
  version        Int       @default(1)
  changeReason   String?
  changedBy      String?
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Created before a sender pays; represents "what should happen" (PRD §8).
model DepositIntent {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      Recipient     @relation(fields: [recipientId], references: [id])
  idempotencyKey String        @unique
  toChainId      Int
  toToken        String
  minAmount      Decimal? @db.Decimal(78, 0)
  maxAmount      Decimal? @db.Decimal(78, 0)
  status         String        @default("PENDING") // PENDING | AWAITING_SIGNATURE | IN_FLIGHT | SETTLED | FAILED
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  quotes         Quote[]
  transactions   Transaction[]
}

/// One route for a deposit; a deposit can be re-quoted on expiry (PRD §8).
model Quote {
  id                 String        @id @default(cuid())
  depositIntentId    String
  depositIntent      DepositIntent @relation(fields: [depositIntentId], references: [id], onDelete: Cascade)
  fromChainId        Int
  fromToken          String
  fromAmount         Decimal @db.Decimal(78, 0)
  fromAddress        String?
  toAddress          String?
  routePath          Json
  estimatedFee       Decimal @db.Decimal(78, 0)
  estimatedTimeSeconds Int
  estimatedOutput    Decimal @db.Decimal(78, 0)
  slippageBps        Int
  reliability        Float
  settlementBaseline Decimal? @db.Decimal(78, 0)
  transactionRequest Json
  hopTransactionRequests Json
  status             String        @default("ACTIVE") // ACTIVE | EXPIRED | USED | REJECTED
  expiresAt          DateTime
  providerId         String? // adapterId of the winning route (routing KPIs)
  simulated          Boolean       @default(false)
  fallbackFromQuoteId String? // set when this quote was produced by a fallback
  fallbackFromHop    Int?
  /// Ranking penalty score from rankRoutes (lower = better route). Persisted
  /// for post-hoc route-decision analysis (Next-Gen Routing PRD §Monitoring).
  score              Float?
  /// Snapshot of the losing candidates' summary metrics at quote time, so a
  /// historical quote can be audited against the routes it was not chosen over.
  alternatesSnapshot Json?
  /// Normalized route entity (Next-Gen Routing PRD §Data Model). The Quote's
  /// `routePath` remains the canonical execution plan; `route` mirrors it as a
  /// first-class, queryable entity with a provider summary.
  routeId            String?       @unique
  route              Route?        @relation(fields: [routeId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  transactions       Transaction[]
}

/// Normalized route entity (Next-Gen Routing PRD §Data Model): the steps a
/// quote executes plus a summary of the providers involved. The Quote owns the
/// FK (`Quote.routeId`), so the route can be created independently and then
/// attached.
model Route {
  id            String   @id @default(cuid())
  steps         Json
  /// Summary of the providers used across all hops, e.g. "uniswap-v3+cctp-v2".
  providerChain String?
  quote         Quote?
  createdAt     DateTime @default(now())
}

/// One row per on-chain hop (PRD §8).
model Transaction {
  id              String        @id @default(cuid())
  quoteId         String
  quote           Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  depositIntentId String
  depositIntent   DepositIntent @relation(fields: [depositIntentId], references: [id], onDelete: Cascade)
  hopIndex        Int
  chainId         Int
  txHash          String?
  status          String        @default("PENDING") // PENDING | SUBMITTED | CONFIRMED | SETTLEMENT_PENDING | FAILED | TIMEOUT
  errorCode       String?
  submittedAt     DateTime?
  confirmedAt     DateTime?
  settledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model WebhookSubscription {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  events    String[] // quote.ready | tx.submitted | deposit.settled | deposit.failed
  secret    String
  enabled   Boolean  @default(true)
  deliveries WebhookDelivery[]
  createdAt DateTime @default(now())
}

/// Lifecycle event queue consumed by the webhook-dispatch worker.
model Event {
  id              String   @id @default(cuid())
  projectId       String
  depositIntentId String?
  type            String // quote.ready | tx.submitted | deposit.settled | deposit.failed
  payload         Json
  createdAt       DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String?
  actor      String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  /// Requester IP and user agent, captured from request context (Next-Gen
  /// Routing PRD §Security: "Include IP, user agent").
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(cuid())
  depositId String?
  code      String
  message   String
  context   Json?
  createdAt DateTime @default(now())
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String
  organizationId String?
  projectId      String?
  operation      String
  response       Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([key, operation])
  @@index([expiresAt])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  eventId        String?
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime?
  responseCode   Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model AnalyticsDaily {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  day            DateTime
  deposits       Int      @default(0)
  settled        Int      @default(0)
  failed         Int      @default(0)
  volume         Decimal  @default(0) @db.Decimal(78, 0)
  settledVolume  Decimal  @default(0) @db.Decimal(78, 0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, day])
  @@index([organizationId, projectId, day])
}
