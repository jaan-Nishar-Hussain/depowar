generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Integrator / tenant that owns API keys and webhooks.
model Client {
  id             String             @id @default(cuid())
  name           String
  apiKeys        ApiKey[]
  webhooks       WebhookSubscription[]
  recipients     Recipient[]
  depositIntents DepositIntent[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  testProject    Project?           @relation("ProjectTestClient")
  liveProject    Project?           @relation("ProjectLiveClient")
  environment    String             @default("TEST")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  memberships  Membership[]
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  ownerId      String?
  owner        User?         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  memberships  Membership[]
  projects     Project[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("DEVELOPER")
  status         String       @default("ACTIVE")
  invitedBy      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  environment    String       @default("DEVELOPMENT")
  clientId       String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation("ProjectTestClient", fields: [clientId], references: [id], onDelete: Cascade)
  liveClientId   String?      @unique
  liveClient     Client?      @relation("ProjectLiveClient", fields: [liveClientId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ApiKey {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keyPrefix  String
  keyHash    String    @unique
  name       String?
  environment String   @default("TEST")
  scopes     String[]  @default(["deposits", "quote", "webhooks"])
  enabled    Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt DateTime?

  @@index([clientId, enabled])
}

/// Recipient: where and how funds settle (PRD §8).
model Recipient {
  id                String             @id @default(cuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  walletAddress     String
  settlementType    String             @default("EOA") // EOA | CONTRACT
  preferredChainId  Int?
  preferredToken    String?
  kycStatus         String             @default("none") // none | screened | denied
  amlStatus         String             @default("PENDING_REVIEW")
  settlementConfigs SettlementConfig[]
  depositIntents    DepositIntent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model SettlementConfig {
  id             String    @id @default(cuid())
  recipientId    String
  recipient      Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  chainId        Int
  token          String // token address or 'native'
  settlementType String    @default("EOA") // EOA | CONTRACT
  contractAddress String?
  minAmount      Decimal? @db.Decimal(78, 0)
  maxAmount      Decimal? @db.Decimal(78, 0)
  enabled        Boolean   @default(true)
  version        Int       @default(1)
  changeReason   String?
  changedBy      String?
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Created before a sender pays; represents "what should happen" (PRD §8).
model DepositIntent {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      Recipient     @relation(fields: [recipientId], references: [id])
  idempotencyKey String        @unique
  toChainId      Int
  toToken        String
  minAmount      Decimal? @db.Decimal(78, 0)
  maxAmount      Decimal? @db.Decimal(78, 0)
  status         String        @default("PENDING") // PENDING | AWAITING_SIGNATURE | IN_FLIGHT | SETTLED | FAILED
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  quotes         Quote[]
  transactions   Transaction[]
}

/// One route for a deposit; a deposit can be re-quoted on expiry (PRD §8).
model Quote {
  id                 String        @id @default(cuid())
  depositIntentId    String
  depositIntent      DepositIntent @relation(fields: [depositIntentId], references: [id], onDelete: Cascade)
  fromChainId        Int
  fromToken          String
  fromAmount         Decimal @db.Decimal(78, 0)
  fromAddress        String?
  toAddress          String?
  routePath          Json
  estimatedFee       Decimal @db.Decimal(78, 0)
  estimatedTimeSeconds Int
  estimatedOutput    Decimal @db.Decimal(78, 0)
  slippageBps        Int
  reliability        Float
  settlementBaseline Decimal? @db.Decimal(78, 0)
  transactionRequest Json
  hopTransactionRequests Json
  status             String        @default("ACTIVE") // ACTIVE | EXPIRED | USED | REJECTED
  expiresAt          DateTime
  providerId         String? // adapterId of the winning route (routing KPIs)
  simulated          Boolean       @default(false)
  fallbackFromQuoteId String? // set when this quote was produced by a fallback
  fallbackFromHop    Int?
  /// Ranking penalty score from rankRoutes (lower = better route). Persisted
  /// for post-hoc route-decision analysis (Next-Gen Routing PRD §Monitoring).
  score              Float?
  /// Snapshot of the losing candidates' summary metrics at quote time, so a
  /// historical quote can be audited against the routes it was not chosen over.
  alternatesSnapshot Json?
  createdAt          DateTime      @default(now())
  transactions       Transaction[]
}

/// One row per on-chain hop (PRD §8).
model Transaction {
  id              String        @id @default(cuid())
  quoteId         String
  quote           Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  depositIntentId String
  depositIntent   DepositIntent @relation(fields: [depositIntentId], references: [id], onDelete: Cascade)
  hopIndex        Int
  chainId         Int
  txHash          String?
  status          String        @default("PENDING") // PENDING | SUBMITTED | CONFIRMED | SETTLEMENT_PENDING | FAILED | TIMEOUT
  errorCode       String?
  submittedAt     DateTime?
  confirmedAt     DateTime?
  settledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model WebhookSubscription {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url       String
  events    String[] // quote.ready | tx.submitted | deposit.settled | deposit.failed
  secret    String
  enabled   Boolean  @default(true)
  deliveries WebhookDelivery[]
  createdAt DateTime @default(now())
}

/// Lifecycle event queue consumed by the webhook-dispatch worker.
model Event {
  id              String   @id @default(cuid())
  clientId        String
  depositIntentId String?
  type            String // quote.ready | tx.submitted | deposit.settled | deposit.failed
  payload         Json
  createdAt       DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  clientId   String?
  actor      String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  /// Requester IP and user agent, captured from request context (Next-Gen
  /// Routing PRD §Security: "Include IP, user agent").
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(cuid())
  depositId String?
  code      String
  message   String
  context   Json?
  createdAt DateTime @default(now())
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String
  organizationId String?
  projectId      String?
  operation      String
  response       Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([key, operation])
  @@index([expiresAt])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  eventId        String?
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime?
  responseCode   Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model AnalyticsDaily {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  clientId       String
  day            DateTime
  deposits       Int      @default(0)
  settled        Int      @default(0)
  failed         Int      @default(0)
  volume         Decimal  @default(0) @db.Decimal(78, 0)
  settledVolume  Decimal  @default(0) @db.Decimal(78, 0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, clientId, day])
  @@index([organizationId, projectId, day])
}
