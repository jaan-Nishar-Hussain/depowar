# Depowar consumer demo — paste your project API key here.
# Copy to `.env`, fill VITE_API_KEY, then run `pnpm --filter @paymesh/consumer-demo dev`.

# The project API key minted when you create a project in the dashboard
# (Organization → Create project) or in the Access tab after revoking the
# current key. The demo auto-loads the project's receiver from the API.
VITE_API_KEY=

# Optional overrides — leave unset to auto-bootstrap from the project.
VITE_API_URL=http://localhost:4000
# VITE_RECIPIENT_ID=
# VITE_TO_CHAIN=
# VITE_TO_TOKEN=
# VITE_TO_TOKEN_SYMBOL=USDC
# VITE_BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913